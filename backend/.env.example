PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/agriconnect?schema=public"
JWT_SECRET="your_jwt_secret_must_be_long_and_secure"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_must_be_long_and_secure"
SUPABASE_URL="https://elqvrqydxpykxurmziky.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
FIREBASE_SERVICE_ACCOUNT="./firebase-service-account.json"
AWS_ACCESS_KEY_ID="your_aws_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_S3_BUCKET="your_s3_bucket"
# Sends the forgot-password reset code. Dedicated project Gmail account, not
# a personal one — GMAIL_APP_PASSWORD is an App Password (requires 2-Step
# Verification enabled on that account), not the account's login password.
GMAIL_USER="your_project_gmail@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"
NODE_ENV="development"

# 32-byte key (base64 or hex) for AES-256-GCM field encryption of sensitive
# data at rest (MoMo numbers). Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""
